{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "raw",
        "source": "\u001b[36m             .:'                \n         __ :'__                \n      .'`__`-'__``.             \n     :__________.-'             \n     :_________:                \n      :_________`-.__           \n       `.__.-.__.'              \n\u001b[35m    THATARCHOS // BRONME DE    \u001b[0m\n",
        "padding": {
